Begin Object Class=/Script/UMG.TextBlock Name="LoaderInfo" ExportPath="/Script/UMG.TextBlock'/Game/Sample/UI/WBP_LFXSample_LoaderPage.WBP_LFXSample_LoaderPage:WidgetTree.LoaderInfo'"
   Text=NSLOCTEXT("", "88A8B7464B1CC56B4EEE38A207FFCB10", "Load Assets Async loads the 21 bundled materials from soft references and reports progress each time one arrives. The LoadingFX Progress Bar eases between the steps (Smoothing Time 0.5 s here). The loaded assets stay referenced until Release, or until this page, their Owner, goes away.")
   Font=(TypefaceFontName="Regular",Size=14.000000)
   WrapTextAt=680.000000
   DisplayLabel="LoaderInfo"
End Object
