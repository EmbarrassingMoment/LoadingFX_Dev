Begin Object Class=/Script/UMG.TextBlock Name="IconInfo" ExportPath="/Script/UMG.TextBlock'/Game/Sample/UI/WBP_LFXSample_IconPage.WBP_LFXSample_IconPage:WidgetTree.IconInfo'"
   Text=NSLOCTEXT("", "B1CBF7E341351E2943227DBB7EC2CA30", "The loading icon draws the material chosen in Project Settings > Plugins > LoadingFX, shown here. It appears once a request is 0.5 s old (Icon Show Delay) and then stays up for at least 1 s (Icon Minimum Display Time), so a short load shows nothing and a load just over the delay does not flicker.")
   Font=(TypefaceFontName="Regular",Size=14.000000)
   WrapTextAt=600.000000
   DisplayLabel="IconInfo"
End Object
Begin Object Class=/Script/UMG.TextBlock Name="TasksInfo" ExportPath="/Script/UMG.TextBlock'/Game/Sample/UI/WBP_LFXSample_IconPage.WBP_LFXSample_IconPage:WidgetTree.TasksInfo'"
   Text=NSLOCTEXT("", "EF7DE28740F5747E30F1DAAE14C972CE", "Each button acquires the icon, waits, then releases it. The log below shows when the icon really appears and hides.")
   Font=(TypefaceFontName="Regular",Size=14.000000)
   WrapTextAt=680.000000
   DisplayLabel="TasksInfo"
End Object
